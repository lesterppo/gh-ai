@click.argument("repo")
@click.argument("pr_number", type=int)
@click.option("--max-lines", type=int, default=300, help="Maximum diff lines (default 300)")
def pr_diff(repo, pr_number, max_lines):
    """Get PR diff with line numbers. Truncated by default."""
    _check_token()

    text = requests.get(
        f"{BASE_URL}/repos/{repo}/pulls/{pr_number}",
        headers=_headers("application/vnd.github.v3.diff"),
        timeout=30,
    ).text

    if not text:
        click.echo("(empty diff)")
        return

    lines = text.splitlines()
    total = len(lines)
    if total > max_lines:
        lines = lines[:max_lines]

    for i, line in enumerate(lines, 1):
        click.echo(f"{i}: {line}")

    if total > max_lines:
        click.echo(f"... (truncated: {total - max_lines} more lines)")


@cli.command(name="pr-status")
@click.argument("repo")
@click.argument("pr_number", type=int)
def pr_status(repo, pr_number):
    """One-line PR status: state, mergeable, CI conclusion, URL."""
    _check_token()

    pr = requests.get(
        f"{BASE_URL}/repos/{repo}/pulls/{pr_number}",
        headers=_headers(),
        timeout=30,
    ).json()
    if "message" in pr:
        click.echo(f"Not found: {repo}#{pr_number}", err=True)
        sys.exit(5)

    state = pr.get("state", "?")
    merged = pr.get("merged", False)
    draft = "📝" if pr.get("draft") else ""
    mergeable = pr.get("mergeable_state", "?")

    # Get CI conclusion from head SHA
    head_sha = pr.get("head", {}).get("sha")
    ci = "?"
    if head_sha:
        checks = requests.get(
            f"{BASE_URL}/repos/{repo}/commits/{head_sha}/check-runs",
            headers=_headers(),
            timeout=30,
        ).json()
        conclusions = {c.get("conclusion") for c in checks.get("check_runs", []) if c.get("conclusion")}
        if not conclusions:
            ci = "no_checks"
        elif all(c == "success" for c in conclusions):
            ci = "✓"
        elif any(c in ("failure", "timed_out", "cancelled") for c in conclusions):
            ci = "✗"
        else:
            ci = "○"

    status = "merged" if merged else state
    click.echo(f"{status}{' ' + draft if draft else ''} | mergeable: {mergeable} | ci: {ci} | {pr['html_url']}")


