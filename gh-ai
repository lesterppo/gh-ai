@cli.command(name="discussion-list")
@click.argument("repo")
@click.option("--max", "max_items", type=int, default=DEFAULT_LIST, help="Max results")
def discussion_list(repo, max_items):
    """List Discussions (requires Discussions enabled on the repo)."""
    d = _gql(
        """query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){
          discussions(first:$n){nodes{id number title answerChosenAt upvoteCount
            category{name} comments{totalCount}}}}}""",
        {"o": repo.split("/")[0], "r": repo.split("/")[1], "n": min(max_items, 50)},
    )
    items = (d.get("repository") or {}).get("discussions", {}).get("nodes", [])
    if not items:
        click.echo("(none or Discussions not enabled)")
        return
