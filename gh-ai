def agent_secret(repo, secret_name, value, delete_name):
    """Manage GitHub Agents secrets: list (default), --set, --delete."""
    if delete_name:
        _request(f"/repos/{repo}/agents/secrets/{delete_name}", method="DELETE")
        click.echo(f"✓ Agent secret {delete_name} deleted")
        return
    if secret_name:
