        return "(no results)"
    for i, item in enumerate(items, 1):
        repo = item.get("repository_url", "").rsplit("/", 2)[-2:]
        repo_name = "/".join(repo) if len(repo) == 2 else "?"
        title = item.get("title", "")
        state = item.get("state", "")
        num = item.get("number", "?")
        out.append(f"{i}. [{repo_name}#{num}] {title} ({state})")
    return "\n".join(out)


def _format_search_code(results, max_items=SEARCH_TOP):
    out = []
    items = results.get("items", [])[:max_items]
    if not items:
        return "(no results)"
    for i, item in enumerate(items, 1):
        repo = item.get("repository", {}).get("full_name", "?")
        path = item.get("path", "")
        out.append(f"{i}. {repo} | {path}")
