@cli.command(name="action-list")
@click.argument("repo")
@click.option("--max", "max_items", type=int, default=DEFAULT_LIST, help="Max results")
def action_list(repo, max_items):
    """List workflows in a repository."""
    items = _get_list(f"/repos/{repo}/actions/workflows", max_items=max_items)
    if not items:
        click.echo("(none)")
        return
    for w in items:
        click.echo(f"{w.get('name', '?')} | {w.get('path', '?')} | {w.get('state', '?')}")


@cli.command(name="action-runs")
@click.argument("repo")
@click.option("--branch", default=None, help="Filter by branch")
@click.option("--status", default=None, help="Filter by status: completed/queued/in_progress/..."
              " or conclusion: success/failure/cancelled")
@click.option("--event", default=None, help="Filter by trigger event (push, pull_request, ...)")
@click.option("--workflow", default=None, help="Filter by workflow file name or ID")
@click.option("--max", "max_items", type=int, default=DEFAULT_LIST, help="Max results")
def action_runs(repo, branch, status, event, workflow, max_items):
    """List workflow runs."""
    params = {}
    if branch:
        params["branch"] = branch
    if status:
        params["status"] = status
    if event:
        params["event"] = event
    if workflow:
        params["workflow_id"] = workflow
    items = _get_list(f"/repos/{repo}/actions/runs", max_items=max_items, **params)
    if not items:
        click.echo("(none)")
        return
    for r in items:
        conclusion = r.get("conclusion") or r.get("status", "?")
        icon = "✓" if conclusion == "success" else "✗" if conclusion in ("failure", "cancelled", "timed_out") else "○"
        title = (r.get("display_title") or r.get("name") or "?").replace("\n", " ")[:60]
        click.echo(f"{icon} {r.get('id', '?')} | {title} | {r.get('head_branch', '?')} | {r.get('event', '?')} | {conclusion} | {_sha7(r.get('head_sha'))}")


@cli.command(name="action-run")
@click.argument("repo")
@click.argument("run_id")
def action_run(repo, run_id):
    """View a single workflow run with its jobs and steps."""
    r = _request(f"/repos/{repo}/actions/runs/{run_id}")
    conclusion = r.get("conclusion") or r.get("status", "?")
    click.echo(f"run {r.get('id', '?')} | {(r.get('display_title') or r.get('name') or '?')[:80]}")
    click.echo(f"branch: {r.get('head_branch', '?')} | event: {r.get('event', '?')} | conclusion: {conclusion}")
    click.echo(f"sha: {_sha7(r.get('head_sha'))} | created: {_d(r.get('created_at'))} | duration: {(r.get('updated_at') or '')[:19]}")
    jobs = _get_list(f"/repos/{repo}/actions/runs/{run_id}/jobs", max_items=50)
    for j in jobs:
        jc = j.get("conclusion") or j.get("status", "?")
        icon = "✓" if jc == "success" else "✗" if jc in ("failure", "cancelled", "timed_out") else "○"
        click.echo(f"  {icon} job: {j.get('name', '?')} | {jc}")
        for step in j.get("steps", []):
            sc = step.get("conclusion") or step.get("status", "?")
            click.echo(f"      - {step.get('name', '?')}: {sc}")


