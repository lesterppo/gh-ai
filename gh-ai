    """List or modify repository topics."""
    accept = "application/vnd.github.mercy-preview+json"
    if not (add_topics or remove_topics or set_topics):
        data = _request(f"/repos/{repo}/topics", accept=accept)
        names = data.get("names", [])
        click.echo(", ".join(names) if names else "(no topics)")
        return
    current = _request(f"/repos/{repo}/topics", accept=accept).get("names", [])
