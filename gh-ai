@click.argument("path", required=False, default="")
@click.option("--ref", "branch", default=None, help="Branch/tag/SHA")
def dir_list(repo, path, branch):
    """List directory contents (or show one file)."""
    encoded = urllib.parse.quote(path, safe="")
    qs = f"?ref={urllib.parse.quote(branch)}" if branch else ""
    data = _request(f"/repos/{repo}/contents/{encoded}{qs}")
    if isinstance(data, dict):
        # Single file: decode base64 and print like file-read
        content = data.get("content", "")
        try:
            text = base64.b64decode(content).decode("utf-8", errors="replace")
        except Exception:
            text = "(binary)"
        lines = text.splitlines()
        for i, line in enumerate(lines[:MAX_FILE_LINES], 1):
            click.echo(f"{i}: {line}")
        if len(lines) > MAX_FILE_LINES:
            click.echo(f"... (truncated: {len(lines) - MAX_FILE_LINES} more lines)")
        return
    if not data:
        click.echo("(empty)")
        return
    for item in data:
        name = item.get("name", "?")
        kind = "dir" if item.get("type") == "dir" else "file"
        size = item.get("size", 0)
        click.echo(f"{kind}\t{size}\t{name}")


@cli.command()
@click.argument("repo")
@click.argument("path")
@click.option("--start", type=int, default=None, help="First line (1-indexed)")
@click.option("--end", type=int, default=None, help="Last line (1-indexed, inclusive)")
def file_read(repo, path, start, end):
    """Read a file with line numbers. Supports --start/--end for slicing."""
    encoded_path = urllib.parse.quote(path, safe="")
    text = _request(f"/repos/{repo}/contents/{encoded_path}", raw=True)

    lines = text.splitlines()
    line_start = start or 1
    line_end = end or len(lines)

    if line_start < 1:
        line_start = 1
    if line_end > len(lines):
        line_end = len(lines)

    sliced = lines[line_start - 1 : line_end]
    total = len(sliced)

    if total > MAX_FILE_LINES:
        sliced = sliced[:MAX_FILE_LINES]
        trunc = True
    else:
        trunc = False

    for i, line in enumerate(sliced):
        click.echo(f"{line_start + i}: {line}")

    if trunc:
        click.echo(f"... (truncated: {total - MAX_FILE_LINES} more lines)")


@cli.command(name="file-write")
@click.argument("repo")
@click.argument("path")
@click.option("--content", default=None, help="File content")
@click.option("--file", "content_file", default=None, help="Read content from file")
@click.option("--message", default=None, help="Commit message (required)")
@click.option("--branch", default=None, help="Branch (default: repo default)")
@click.option("--sha", default=None, help="Existing file SHA (required to update)")
def file_write(repo, path, content, content_file, message, branch, sha):
    """Create or update a file via the Contents API."""
    if content is None and content_file:
        try:
            with open(content_file, "r") as f:
                content = f.read()
        except OSError as e:
            click.echo(f"Cannot read file: {e}", err=True)
            sys.exit(1)
    if content is None and not sys.stdin.isatty():
        content = sys.stdin.read()
    if content is None:
        click.echo("No content. Use --content, --file, or pipe on stdin.", err=True)
        sys.exit(1)
    if not message:
        click.echo("--message is required", err=True)
        sys.exit(1)
    payload = {
        "message": message,
        "content": base64.b64encode(content.encode("utf-8")).decode("ascii"),
    }
    if branch:
        payload["branch"] = branch
    if sha:
        payload["sha"] = sha
    data = _request(f"/repos/{repo}/contents/{urllib.parse.quote(path, safe='')}", method="PUT", json=payload)
    commit = (data.get("commit") or {})
    click.echo(f"✓ Written {path} | sha {_sha7(commit.get('sha'))} | {commit.get('message', '')[:60]}")


