@cli.command()
def rate_limit():
    """Show current GitHub API rate limit status."""
    data = _request("/rate_limit")
    resources = data.get("resources", {})
    for name in ("core", "search", "graphql", "actions", "code_scanning_upload"):
        res = resources.get(name)
        if not res:
            continue
        remaining = res.get("remaining", "?")
        limit = res.get("limit", "?")
        reset = time.strftime("%H:%M:%S", time.localtime(res.get("reset", 0)))
        click.echo(f"{name}: {remaining}/{limit} remaining, resets {reset}")


@cli.command(name="auth-status")
def auth_status():
    """Show authenticated user and token scopes."""
    _check_token()
    resp = requests.get(f"{BASE_URL}/user", headers=_headers(), timeout=30)
    if resp.status_code >= 400:
        _fail_status(resp, "/user")
    user = resp.json()
    scopes = resp.headers.get("X-OAuth-Scopes", "").strip() or "(no scopes)"
    click.echo(f"login: {user.get('login', '?')}")
    click.echo(f"name: {user.get('name') or ''}")
    click.echo(f"scopes: {scopes}")
    click.echo(f"rate: {resp.headers.get('X-RateLimit-Remaining', '?')}/{resp.headers.get('X-RateLimit-Limit', '?')}")


@cli.command()
@click.argument("path")
@click.option("--method", default="GET", help="HTTP method (GET/POST/PATCH/PUT/DELETE)")
@click.option("--data", default=None, help="JSON body string")
@click.option("--data-file", default=None, help="Read JSON body from file")
@click.option("--raw", is_flag=True, default=False, help="Print raw body (e.g. for diff/text endpoints)")
def api(path, method, data, data_file, raw):
    """Raw GitHub REST API passthrough. Escape hatch for any endpoint.

    Path may omit the leading slash: gh-ai api repos/o/r. Accept headers:
    add the header suffix in parens, e.g. 'repos/o/r/pulls/1 --raw' uses
    the .diff media type automatically when --raw is set.
    """
    _check_token()
    if not path.startswith("/"):
        path = "/" + path
    body = None
    if data:
        try:
            body = json_parse(data)
        except Exception:
            body = data
    elif data_file:
        try:
            with open(data_file, "r") as f:
                body = json_parse(f.read())
        except OSError as e:
            click.echo(f"Cannot read data file: {e}", err=True)
            sys.exit(1)

    accept = None
