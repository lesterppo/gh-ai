@cli.command(name="release-list")
@click.argument("repo")
@click.option("--max", "max_items", type=int, default=DEFAULT_LIST, help="Max results")
def release_list(repo, max_items):
    """List releases."""
    items = _get_list(f"/repos/{repo}/releases", max_items=max_items)
    if not items:
        click.echo("(none)")
        return
    for r in items:
        flags = []
        if r.get("draft"):
            flags.append("draft")
        if r.get("prerelease"):
            flags.append("pre")
        flag_str = f" [{','.join(flags)}]" if flags else ""
        assets = len(r.get("assets", []))
        click.echo(f"{r.get('tag_name', '?')}{flag_str} | {(r.get('name') or r.get('tag_name') or '?')[:60]} | {_d(r.get('published_at'))} | {assets} assets")


@cli.command(name="release-view")
@click.argument("repo")
@click.argument("tag", required=False)
@click.option("--latest", is_flag=True, default=False, help="Show latest release")
def release_view(repo, tag, latest):
    """Show a release (by tag, or --latest)."""
    if latest:
        r = _request(f"/repos/{repo}/releases/latest")
    elif tag:
        r = _request(f"/repos/{repo}/releases/tags/{tag}")
    else:
        click.echo("Pass a TAG or --latest", err=True)
        sys.exit(1)
    click.echo(f"tag: {r.get('tag_name', '?')} | {(r.get('name') or '?')[:80]}")
    click.echo(f"draft: {r.get('draft', False)} | prerelease: {r.get('prerelease', False)} | published: {_d(r.get('published_at'))}")
    body = (r.get("body") or "").strip()
    if body:
        click.echo("--- body ---")
        lines = body.splitlines()
        total = len(lines)
        for i, line in enumerate(lines[:200], 1):
