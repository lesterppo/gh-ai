@cli.command()
@click.argument("query")
@click.option("--var", "vars", multiple=True, help="Variable as JSON k=v (repeatable)")
def graphql(query, vars):
    """Run an arbitrary GraphQL query (escape hatch for Projects v2, Discussions, etc.)."""
    variables = None
    if vars:
        variables = {}
        for v in vars:
            if "=" in v:
                k, _, val = v.partition("=")
                variables[k] = val
    data = _gql(query, variables)
    click.echo(json_dumps(data))


def _resolve_project_owner(owner, org, repo_name):
    """Return (ownerId, projectV2Id, number) for the target scope."""
    if repo_name:
        d = _gql(
            "query($o:String!,$r:String!){repository(owner:$o,name:$r){id projectsV2(first:20){nodes{id title number}}}}",
            {"o": repo_name.split("/")[0], "r": repo_name.split("/")[1]},
        )
        return d.get("repository", {}), None
    if org:
        d = _gql(
            "query($o:String!){organization(login:$o){id projectsV2(first:20){nodes{id title number}}}}",
            {"o": org},
        )
        return d.get("organization", {}), None
    d = _gql(
        "query{viewer{id projectsV2(first:20){nodes{id title number}}}}"
    )
    return d.get("viewer", {}), None


def _find_project(number, org_name, repo_name):
    """Find a Projects v2 board by number. With --repo, falls back to the
    repo owner's own projects (createProjectV2 makes owner-scoped boards)."""
    if repo_name:
        scope, _ = _resolve_project_owner(None, None, repo_name)
        projects = (scope.get("projectsV2") or {}).get("nodes", [])
        proj = next((p for p in projects if p.get("number") == number), None)
        if proj:
            return proj
        owner_login = repo_name.split("/")[0]
        try:
            d = _gql(
                "query($o:String!){user(login:$o){projectsV2(first:50){nodes{id number title}}}}",
                {"o": owner_login},
            )
            projects = (d.get("user") or {}).get("projectsV2", {}).get("nodes", [])
            return next((p for p in projects if p.get("number") == number), None)
        except SystemExit:
            return None
    scope, _ = _resolve_project_owner(None, org_name, None)
    projects = (scope.get("projectsV2") or {}).get("nodes", [])
    return next((p for p in projects if p.get("number") == number), None)


