@cli.command(name="get-action-errors")
@click.argument("repo")
@click.argument("run_id")
def get_action_errors(repo, run_id):
    """Fetch GitHub Actions logs and extract only error blocks with context."""
    _request(f"/repos/{repo}/actions/runs/{run_id}")

    url = f"{BASE_URL}/repos/{repo}/actions/runs/{run_id}/logs"
    resp = requests.get(url, headers=_headers(), allow_redirects=True, timeout=60)
    if resp.status_code != 200:
        click.echo(f"Failed to fetch logs: HTTP {resp.status_code}", err=True)
        sys.exit(6)

    ansi_escape = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")

    try:
        with zipfile.ZipFile(io.BytesIO(resp.content)) as zf:
            all_logs = []
            for name in sorted(zf.namelist()):
                with zf.open(name) as f:
                    text = f.read().decode("utf-8", errors="replace")
                    text = ansi_escape.sub("", text)
                    all_logs.append(f"# {name}\n{text}")
            log_text = "\n".join(all_logs)
    except (zipfile.BadZipFile, OSError):
        log_text = ansi_escape.sub("", resp.text)

    click.echo(_format_log_errors(log_text))


@cli.command(name="action-secret")
@click.argument("repo")
@click.option("--set", "secret_name", default=None, help="Secret name to set")
@click.option("--value", default=None, help="Secret value (for --set)")
@click.option("--value-file", default=None, help="Read secret value from file")
@click.option("--delete", "delete_name", default=None, help="Secret name to delete")
def action_secret(repo, secret_name, value, value_file, delete_name):
    """Manage Actions secrets: list (default), --set name --value, --delete name."""
    if delete_name:
        _request(f"/repos/{repo}/actions/secrets/{delete_name}", method="DELETE")
        click.echo(f"✓ Secret {delete_name} deleted")
        return
    if secret_name:
        if value is None and value_file:
            try:
                with open(value_file, "r") as f:
                    value = f.read()
            except OSError as e:
                click.echo(f"Cannot read value file: {e}", err=True)
                sys.exit(1)
        if value is None:
            click.echo("--value or --value-file required with --set", err=True)
            sys.exit(1)
        key = _request(f"/repos/{repo}/actions/secrets/public-key")
        encrypted = _encrypt_secret(key.get("key", ""), value)
        _request(f"/repos/{repo}/actions/secrets/{secret_name}", method="PUT",
                 json={"encrypted_value": encrypted, "key_id": key.get("key_id", "")})
        click.echo(f"✓ Secret {secret_name} set")
        return
    data = _request(f"/repos/{repo}/actions/secrets")
    names = [s.get("name") for s in data.get("secrets", [])]
    click.echo(", ".join(names) if names else "(no secrets)")


@cli.command(name="action-variable")
@click.argument("repo")
@click.option("--set", "var_name", default=None, help="Variable name to set")
@click.option("--value", default=None, help="Variable value (for --set)")
@click.option("--delete", "delete_name", default=None, help="Variable name to delete")
def action_variable(repo, var_name, value, delete_name):
    """Manage Actions variables: list (default), --set name --value, --delete name."""
    if delete_name:
        _request(f"/repos/{repo}/actions/variables/{delete_name}", method="DELETE")
        click.echo(f"✓ Variable {delete_name} deleted")
        return
    if var_name:
        if value is None:
            click.echo("--value required with --set", err=True)
            sys.exit(1)
        # Probe existence without hard-exiting on 404 (new variable)
        resp = requests.get(f"{BASE_URL}/repos/{repo}/actions/variables/{var_name}",
                            headers=_headers(), timeout=30)
        if resp.status_code == 404:
            _request(f"/repos/{repo}/actions/variables", method="POST",
                     json={"name": var_name, "value": value})
            click.echo(f"✓ Variable {var_name} set (created)")
        elif resp.status_code >= 400:
            _fail_status(resp, f"/repos/{repo}/actions/variables/{var_name}")
        else:
            _request(f"/repos/{repo}/actions/variables/{var_name}", method="PATCH",
                     json={"value": value})
            click.echo(f"✓ Variable {var_name} set (updated)")
        return
    data = _request(f"/repos/{repo}/actions/variables")
    vars_ = data.get("variables", [])
    if not vars_:
        click.echo("(no variables)")
        return
    for v in vars_:
        click.echo(f"{v.get('name', '?')} = {v.get('value', '')}")


@cli.command(name="action-cache")
@click.argument("repo")
def action_cache(repo):
