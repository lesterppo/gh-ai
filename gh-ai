@cli.command(name="issue-update")
@click.argument("repo")
@click.argument("issue_number", type=int)
@click.option("--title", default=None, help="New title")
@click.option("--body", default=None, help="New body")
@click.option("--state", type=click.Choice(["open", "closed"]), default=None, help="Set state")
@click.option("--label", "labels", multiple=True, help="Replace labels with these")
@click.option("--add-label", "add_labels", multiple=True, help="Add label (keep existing)")
@click.option("--remove-label", "remove_labels", multiple=True, help="Remove label")
@click.option("--assignee", "assignees", multiple=True, help="Replace assignees")
@click.option("--add-assignee", "add_assignees", multiple=True, help="Add assignee")
@click.option("--remove-assignee", "remove_assignees", multiple=True, help="Remove assignee")
@click.option("--milestone", type=int, default=None, help="Set milestone number")
def issue_update(repo, issue_number, title, body, state, labels, add_labels, remove_labels,
                 assignees, add_assignees, remove_assignees, milestone):
    """Update an issue: title, body, state, labels, assignees, milestone."""
    payload = {}
    if title is not None:
        payload["title"] = title
    if body is not None:
        payload["body"] = body
    if state is not None:
        payload["state"] = state
    if milestone is not None:
        payload["milestone"] = milestone

    if labels or add_labels or remove_labels:
        current = [l.get("name") for l in _request(f"/repos/{repo}/issues/{issue_number}").get("labels", [])]
        if labels:
            new_labels = list(labels)
        else:
            new_labels = current
            for l in add_labels:
                if l not in new_labels:
                    new_labels.append(l)
            for l in remove_labels:
                if l in new_labels:
                    new_labels.remove(l)
        payload["labels"] = new_labels

    if assignees or add_assignees or remove_assignees:
        current_as = [a.get("login") for a in _request(f"/repos/{repo}/issues/{issue_number}").get("assignees", [])]
        if assignees:
            new_as = list(assignees)
        else:
            new_as = current_as
            for a in add_assignees:
                if a not in new_as:
                    new_as.append(a)
            for a in remove_assignees:
                if a in new_as:
                    new_as.remove(a)
        payload["assignees"] = new_as

    if not payload:
        click.echo("Nothing to update.", err=True)
        sys.exit(1)
    data = _request(f"/repos/{repo}/issues/{issue_number}", method="PATCH", json=payload)
    click.echo(f"✓ Issue #{issue_number} updated: {data.get('title', '')}")


