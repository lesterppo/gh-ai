@cli.command()
@click.argument("query")
@click.option("--type", "search_type", type=click.Choice(["repos", "issues", "code", "users", "commits", "topics"]),
              default="repos", help="What to search")
@click.option("--max", "max_items", type=int, default=SEARCH_TOP, help="Max results (cap 20)")
def search(query, search_type, max_items):
    """Search GitHub. Types: repos, issues, code, users, commits, topics."""
    encoded = urllib.parse.quote(query)
    per = min(max(max_items, 1), 20)
    if search_type == "repos":
        data = _request(f"/search/repositories?q={encoded}&per_page={per}&sort=stars&order=desc")
        click.echo(_format_search_repos(data, max_items))
    elif search_type == "issues":
        data = _request(f"/search/issues?q={encoded}&per_page={per}&sort=created&order=desc")
        click.echo(_format_search_issues(data, max_items))
    elif search_type == "code":
        data = _request(f"/search/code?q={encoded}&per_page={per}")
        click.echo(_format_search_code(data, max_items))
    elif search_type == "users":
        data = _request(f"/search/users?q={encoded}&per_page={per}")
        click.echo(_format_search_users(data, max_items))
    elif search_type == "commits":
        data = _request(f"/search/commits?q={encoded}&per_page={per}")
        click.echo(_format_search_commits(data, max_items))
    elif search_type == "topics":
        data = _request(f"/search/topics?q={encoded}&per_page={per}")
        click.echo(_format_search_topics(data, max_items))


@cli.command(name="search-code")
@click.argument("query")
@click.option("--repo", "repo_filter", default=None, help="Restrict to repo (repo:owner/name)")
@click.option("--max", "max_items", type=int, default=SEARCH_TOP, help="Max results (cap 20)")
def search_code(query, repo_filter, max_items):
    """Search code (requires auth; needs repo scope for private repos)."""
    q = query
    if repo_filter:
        q = f"repo:{repo_filter} {q}"
    encoded = urllib.parse.quote(q)
    per = min(max(max_items, 1), 20)
    data = _request(f"/search/code?q={encoded}&per_page={per}")
    click.echo(_format_search_code(data, max_items))


