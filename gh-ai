@cli.command()
@click.argument("repo")
@click.option("--read", "page_name", default=None, help="Read a wiki page")
@click.option("--out", "out_dir", default=None, help="Clone wiki into this dir (default: temp)")
def wiki(repo, page_name, out_dir):
    """List or read wiki pages (shallow clone of the .wiki git repo)."""
    import tempfile
    tmp = out_dir or tempfile.mkdtemp(prefix="ghai-wiki-")
    url = f"https://github.com/{repo}.wiki.git"
    result = subprocess.run(["git", "clone", "--depth", "1", url, tmp],
                            capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        click.echo(f"Wiki clone failed: {result.stderr.strip()[:200]}", err=True)
        sys.exit(7)
    if page_name:
        wiki_exts = (".md", ".mediawiki", ".rst", ".asciidoc", ".org", ".textile", ".home", "")
        for fname in sorted(os.listdir(tmp)):
            base, ext = os.path.splitext(fname)
            if base == page_name and ext in wiki_exts:
                with open(os.path.join(tmp, fname), "r") as f:
                    text = f.read()
                lines = text.splitlines()
                for i, line in enumerate(lines[:MAX_FILE_LINES], 1):
                    click.echo(f"{i}: {line}")
                if len(lines) > MAX_FILE_LINES:
                    click.echo("... (truncated)")
                return
        click.echo(f"Page not found: {page_name}", err=True)
        sys.exit(1)
    for fname in sorted(os.listdir(tmp)):
        if fname.endswith((".md", ".mediawiki", ".rst", ".asciidoc", ".org", ".textile")):
            size = os.path.getsize(os.path.join(tmp, fname))
            click.echo(f"{fname} ({size} bytes)")


