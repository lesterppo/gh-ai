                                                        "participation", "punch-card"]),
              default="contributors", help="Statistic type")
@click.option("--max", "max_items", type=int, default=DEFAULT_LIST, help="Max results")
def repo_stats(repo, stat_type, max_items):
    """Repository statistics (contributors, commit activity, code frequency, participation, punch card)."""
    try:
        data = _request(f"/repos/{repo}/stats/{stat_type}")
    except SystemExit:
        click.echo("(no data yet — GitHub computes statistics asynchronously; retry shortly)")
        return
    if not data:
        click.echo("(no data yet — GitHub computes statistics asynchronously; retry shortly)")
        return
    if stat_type == "contributors":
        for c in data[:max_items]:
            weeks = c.get("weeks", [])
            total = sum(w.get("c", 0) for w in weeks)
            click.echo(f"{c.get('author', {}).get('login', '?')}: {total} commits")
    elif stat_type == "commit-activity":
        for w in data:
            click.echo(f"{w.get('week', 0)} | {w.get('total', 0)} commits")
    elif stat_type == "code-frequency":
        for wk in data[:max_items]:
            click.echo(f"week {wk[0]} | +{wk[1]} -{wk[2]}")
    elif stat_type == "participation":
        all_c = data.get("all", [])
        owner_c = data.get("owner", [])
        if all_c:
