@cli.command(name="gist-create")
@click.option("--description", default="", help="Gist description")
@click.option("--file", "files", multiple=True, help="Path of a file to include (repeatable)")
@click.option("--name", "names", multiple=True, help="Filenames matching --content entries")
@click.option("--content", "contents", multiple=True, help="File content (paired with --name)")
@click.option("--public", "public_", is_flag=True, default=False, help="Create a public gist")
@click.option("--stdin-name", default=None, help="Create one file from stdin with this name")
def gist_create(description, files, names, contents, public_, stdin_name):
    """Create a gist. Use --file for real files, or --name/--content pairs,
    or --stdin-name to read one file from stdin."""
    _check_token()
    gist_files = {}
    for fp in files:
        try:
            with open(fp, "r") as f:
                gist_files[os.path.basename(fp)] = {"content": f.read()}
        except OSError as e:
            click.echo(f"Cannot read file {fp}: {e}", err=True)
            sys.exit(1)
    for name, content in zip(names, contents):
        if not name:
            click.echo("--name required for each --content", err=True)
            sys.exit(1)
        gist_files[name] = {"content": content}
    if stdin_name:
        if sys.stdin.isatty():
            click.echo("--stdin-name requires piped stdin", err=True)
            sys.exit(1)
        gist_files[stdin_name] = {"content": sys.stdin.read()}
    if not gist_files:
        click.echo("No files provided. Use --file, --name/--content, or --stdin-name.", err=True)
        sys.exit(1)
    payload = {"description": description, "public": bool(public_), "files": gist_files}
    data = _request("/gists", method="POST", json=payload)
    click.echo(f"✓ Gist created: {data.get('html_url', data.get('id', ''))}")


@cli.command(name="gist-view")
@click.argument("gist_id")
def gist_view(gist_id):
    """View a gist with file contents (capped)."""
    g = _request(f"/gists/{gist_id}")
    desc = (g.get("description") or "").strip()
    click.echo(f"gist: {gist_id} | {desc or '(no description)'} | {g.get('public', '?')} | {_d(g.get('created_at'))}")
    files = g.get("files", {})
    if not files:
        click.echo("(no files)")
        return
    for fname, fdata in files.items():
        click.echo(f"--- {fname} ({fdata.get('size', 0)} bytes) ---")
        content = fdata.get("content") or "(truncated or binary)"
        lines = content.splitlines()
        total = len(lines)
        for i, line in enumerate(lines[:MAX_FILE_LINES], 1):
            click.echo(f"{i}: {line}")
        if total > MAX_FILE_LINES:
            click.echo(f"... (truncated: {total - MAX_FILE_LINES} more lines)")


