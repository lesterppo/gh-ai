def _check_token():
    if not GITHUB_TOKEN:
        click.echo("GITHUB_TOKEN (or GITHUB_PERSONAL_ACCESS_TOKEN, GH_TOKEN) not set", err=True)
        sys.exit(1)


def _headers(accept="application/vnd.github.v3+json"):
    return {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": accept,
        "User-Agent": "gh-ai",
    }


def _fail_status(resp, path):
    """Map a response status code to the canonical gh-ai exit code."""
    if resp.status_code == 401:
        click.echo("Bad credentials. Check GITHUB_TOKEN", err=True)
        sys.exit(3)
    elif resp.status_code == 403:
        if "rate limit" in (resp.text or "").lower():
            reset_ts = resp.headers.get("X-RateLimit-Reset", "unknown")
            click.echo(f"Rate limited. Resets at {reset_ts}", err=True)
        else:
            click.echo(f"Forbidden (403): {resp.text[:200]}", err=True)
        sys.exit(4)
    elif resp.status_code == 404:
        click.echo(f"Not found: {path}", err=True)
        sys.exit(5)
    elif resp.status_code == 422:
        click.echo(f"Unprocessable (422): {resp.text[:300]}", err=True)
        sys.exit(6)
    elif resp.status_code >= 400:
        click.echo(f"HTTP {resp.status_code}: {resp.text[:300]}", err=True)
        sys.exit(6)


def _request(path, raw=False, method="GET", json=None, timeout=30, retry=True, accept=None):
    _check_token()
    url = f"{BASE_URL}{path}"
    hdrs = _headers(accept or ("application/vnd.github.v3.raw" if raw else "application/vnd.github.v3+json"))
    try:
        if method == "GET":
            resp = requests.get(url, headers=hdrs, timeout=timeout, allow_redirects=not raw)
        elif method == "POST":
            resp = requests.post(url, headers=hdrs, json=json, timeout=timeout)
        elif method == "PUT":
            resp = requests.put(url, headers=hdrs, json=json, timeout=timeout)
        elif method == "PATCH":
            resp = requests.patch(url, headers=hdrs, json=json, timeout=timeout)
        elif method == "DELETE":
            resp = requests.delete(url, headers=hdrs, json=json, timeout=timeout)
        else:
            resp = requests.request(method, url, headers=hdrs, json=json, timeout=timeout)
    except requests.RequestException as e:
        if retry and method == "GET":
            time.sleep(1)
            return _request(path, raw=raw, method=method, json=json, timeout=timeout, retry=False, accept=accept)
        click.echo(f"Request failed: {e}", err=True)
        sys.exit(2)

    if resp.status_code == 204:
        return None
    if resp.status_code >= 400:
        _fail_status(resp, path)

    if raw:
        return resp.text
    try:
        return resp.json()
    except ValueError:
        return None


def _get_list(path, max_items=DEFAULT_LIST, extract_keys=None, **params):
    """GET a list endpoint with pagination. Handles plain arrays and
    {total_count, <key>: [...]} envelopes. Returns list capped at max_items."""
    per = min(max(1, int(max_items)), 100)
    params["per_page"] = per
    url = f"{BASE_URL}{path}"
    out = []
    page = 0
    while url and len(out) < max_items:
        page += 1
        if page > 10:
            break
        resp = requests.get(url, headers=_headers(), params=params, timeout=30)
        if resp.status_code >= 400:
            _fail_status(resp, path)
        data = resp.json()
        if isinstance(data, list):
            out.extend(data)
        elif isinstance(data, dict):
            found = False
            for key in extract_keys or ("items", "workflow_runs", "check_runs", "jobs",
                                        "actions_caches", "secrets", "variables", "workflows",
                                        "statuses", "events", "comments", "files", "reviews",
                                        "results"):
                if isinstance(data.get(key), list):
                    out.extend(data[key])
                    found = True
                    break
            if not found:
                break
        link = resp.headers.get("Link", "")
        m = re.search(r'<([^>]+)>;\s*rel="next"', link)
        url = m.group(1) if m else None
        params = {}
    return out[:max_items]


def _upload_file(path, file_path, name=None, timeout=120):
    """Upload a release asset to uploads.github.com. Returns parsed JSON."""
    _check_token()
    if not os.path.isfile(file_path):
        click.echo(f"File not found: {file_path}", err=True)
        sys.exit(1)
    fname = name or os.path.basename(file_path)
    ctype = mimetypes.guess_type(fname)[0] or "application/octet-stream"
    url = f"{UPLOADS_URL}{path}?name={urllib.parse.quote(fname)}"
    hdrs = _headers()
    hdrs["Accept"] = "application/vnd.github.v3+json"
    hdrs["Content-Type"] = ctype  # GitHub rejects uploads without an explicit valid media type
    try:
        with open(file_path, "rb") as f:
            resp = requests.post(url, headers=hdrs, data=f, timeout=timeout)
    except requests.RequestException as e:
        click.echo(f"Upload failed: {e}", err=True)
        sys.exit(2)
    if resp.status_code >= 400:
        _fail_status(resp, path)
    try:
        return resp.json()
    except ValueError:
        return None


def _encrypt_secret(public_key, value):
    """Encrypt an Actions secret with libsodium SealedBox."""
    if not _HAVE_NACL:
        click.echo("pynacl is required for action-secret set: pip install pynacl", err=True)
        sys.exit(1)
    key = nacl.public.PublicKey(base64.b64decode(public_key))
    box = nacl.public.SealedBox(key)
    return base64.b64encode(box.encrypt(value.encode("utf-8"))).decode("ascii")


def _gql(query, variables=None):
    """Run a GraphQL query. Returns the data object; exits on errors."""
    _check_token()
    payload = {"query": query}
    if variables:
        payload["variables"] = variables
    resp = requests.post(f"{BASE_URL}/graphql", headers=_headers(), json=payload, timeout=60)
    if resp.status_code >= 400:
        _fail_status(resp, "/graphql")
    data = resp.json()
    if "errors" in data:
        msgs = "; ".join(e.get("message", "?") for e in data["errors"])
        click.echo(f"GraphQL error: {msgs}", err=True)
        sys.exit(6)
    return data.get("data", {})


