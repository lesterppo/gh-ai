@cli.command(name="action-trigger")
@click.argument("repo")
@click.argument("workflow")
@click.option("--ref", "branch", required=True, help="Branch/tag to run on")
@click.option("--inputs", default=None, help='JSON inputs, e.g. \'{"env":"prod"}\'')
def action_trigger(repo, workflow, branch, inputs):
    """Trigger a workflow_dispatch event."""
    payload = {"ref": branch}
    if inputs:
        try:
            payload["inputs"] = json_parse(inputs)
        except Exception:
            payload["inputs"] = {"text": inputs}
    _request(f"/repos/{repo}/actions/workflows/{workflow}/dispatches", method="POST", json=payload)
    click.echo(f"✓ Dispatched {workflow} on {branch}")


