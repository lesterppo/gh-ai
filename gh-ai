@cli.command(name="project-add-item")
@click.argument("project_number", type=int)
@click.option("--repo", "repo_name", required=True, help="Repo (o/r)")
@click.option("--issue", type=int, default=None, help="Issue number to add")
@click.option("--pr", type=int, default=None, help="PR number to add")
@click.option("--content-id", default=None, help="Raw GraphQL content ID (alternative to --issue/--pr)")
def project_add_item(project_number, repo_name, issue, pr, content_id):
    """Add an issue/PR to a Projects v2 board."""
    proj = _find_project(project_number, None, repo_name)
    if not proj:
        click.echo(f"Project #{project_number} not found for repo {repo_name}", err=True)
        sys.exit(5)
    if not content_id:
        if issue is not None:
            d = _gql(
                "query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){issue(number:$n){id}}}",
                {"o": repo_name.split("/")[0], "r": repo_name.split("/")[1], "n": issue},
            )
            content_id = d.get("repository", {}).get("issue", {}).get("id")
        elif pr is not None:
            d = _gql(
                "query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){id}}}",
                {"o": repo_name.split("/")[0], "r": repo_name.split("/")[1], "n": pr},
            )
            content_id = d.get("repository", {}).get("pullRequest", {}).get("id")
    if not content_id:
        click.echo("Cannot resolve content id (need --issue, --pr, or --content-id)", err=True)
        sys.exit(1)
    d = _gql(
        "mutation($pid:ID!,$cid:ID!){addProjectV2ItemById(input:{projectId:$pid,contentId:$cid}){item{id}}}",
        {"pid": proj["id"], "cid": content_id},
    )
    item = d.get("addProjectV2ItemById", {}).get("item", {})
    click.echo(f"✓ Item added: {item.get('id', '?')}")


