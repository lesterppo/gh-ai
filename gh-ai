@cli.command(name="project-view")
@click.argument("project_number", type=int)
@click.option("--owner", default=None, help="Your project (default)")
@click.option("--org", "org_name", default=None, help="Org name")
@click.option("--repo", "repo_name", default=None, help="Repo (o/r)")
def project_view(project_number, owner, org_name, repo_name):
    """Show a Projects v2 board: title, fields, and items."""
    _ = owner
    proj = _find_project(project_number, org_name, repo_name)
    if not proj:
        click.echo(f"Project #{project_number} not found", err=True)
        sys.exit(5)
    pid = proj["id"]
    click.echo(f"Project #{project_number}: {proj.get('title', '?')}")
    d = _gql(
        """query($id:ID!){ node(id:$id){
          ... on ProjectV2 {
            fields(first:50){nodes{... on ProjectV2SingleSelectField{id name options{id name}}
                                 ... on ProjectV2IterationField{id name configuration{duration}}
                                 ... on ProjectV2FieldCommon{id name}}}
            items(first:50){nodes{id type
              fieldValues(first:30){nodes{
                ... on ProjectV2ItemFieldSingleSelectValue{name field{... on ProjectV2SingleSelectField{name}}}
                ... on ProjectV2ItemFieldTextValue{text field{... on ProjectV2FieldCommon{name}}}
                ... on ProjectV2ItemFieldDateValue{date field{... on ProjectV2FieldCommon{name}}}
              }}
              content{... on Issue{number title state}
                      ... on PullRequest{number title state}
                      ... on DraftIssue{title}}}
            }
          }}}""",
        {"id": pid},
    )
    node = d.get("node", {})
    fields = node.get("fields", {}).get("nodes", [])
    for f in fields:
        if "options" in f:
            opts = ", ".join(o.get("name", "?") for o in f["options"])
            click.echo(f"field: {f.get('name', '?')} [{opts}]")
        else:
            click.echo(f"field: {f.get('name', '?')}")
    items = node.get("items", {}).get("nodes", [])
    if not items:
        click.echo("(no items)")
        return
    for it in items:
        content = it.get("content") or {}
        itype = (it.get("type") or "").upper()
        if itype == "ISSUE":
            label = f"#{content.get('number', '?')} {content.get('title', '?')} ({content.get('state', '?')})"
        elif itype == "PULL_REQUEST":
            label = f"PR#{content.get('number', '?')} {content.get('title', '?')} ({content.get('state', '?')})"
        else:
            label = f"draft: {content.get('title', '?')}"
        vals = []
        for fv in it.get("fieldValues", {}).get("nodes", []):
            if fv.get("name"):
                vals.append(f"{fv.get('field', {}).get('name', '?')}={fv['name']}")
            elif fv.get("text"):
                vals.append(f"{fv.get('field', {}).get('name', '?')}={fv['text']}")
            elif fv.get("date"):
                vals.append(f"{fv.get('field', {}).get('name', '?')}={fv['date']}")
        extra = " | " + ", ".join(vals) if vals else ""
        click.echo(f"item {it.get('id', '?')} | {it.get('type', '?')} | {label}{extra}")


@cli.command(name="project-create")
@click.argument("title")
@click.option("--owner", default=None, help="Create on your account (default)")
@click.option("--org", "org_name", default=None, help="Org name")
@click.option("--repo", "repo_name", default=None, help="Repo (o/r)")
def project_create(title, owner, org_name, repo_name):
    """Create a Projects v2 board."""
    _ = owner
    scope, _ = _resolve_project_owner(None, org_name, repo_name)
    owner_id = scope.get("id")
    if not owner_id:
        click.echo("Cannot resolve owner id", err=True)
        sys.exit(1)
    # Repo scope: projects are owned by the repo's OWNER (user/org), not the repo node
    if repo_name and not org_name:
        d = _gql(
            "query($o:String!,$r:String!){repository(owner:$o,name:$r){owner{id}}}",
            {"o": repo_name.split("/")[0], "r": repo_name.split("/")[1]},
        )
        owner_id = d.get("repository", {}).get("owner", {}).get("id")
        if not owner_id:
            click.echo("Cannot resolve repo owner id", err=True)
            sys.exit(1)
    d = _gql(
        "mutation($oid:ID!,$t:String!){createProjectV2(input:{ownerId:$oid,title:$t}){projectV2{id number title}}}",
        {"oid": owner_id, "t": title},
    )
    p = d.get("createProjectV2", {}).get("projectV2", {})
    hint = " (owner-scoped; view via project-view --repo N thanks to scope fallback)" if repo_name and not org_name else ""
    click.echo(f"✓ Project #{p.get('number', '?')} created: {p.get('title', '?')}{hint}")


