def _login(user):
    if user is None:
        return "ghost"
    return user.get("login", "unknown")


def _d(iso):
    """YYYY-MM-DD (or '' if missing)."""
    if not iso:
        return ""
    return str(iso)[:10]


def _sha7(sha):
    return (sha or "")[:7]


def _resolve_body(body, body_file):
    """Resolve body text from --body, --body-file, or stdin. Exits if none provided."""
    if body:
        return body
    if body_file:
        try:
            with open(body_file, "r") as f:
                return f.read()
        except OSError as e:
            click.echo(f"Cannot read body file: {e}", err=True)
            sys.exit(1)
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return ""


def _require_body(body, body_file):
    """Resolve body and require that it's non-empty."""
    text = _resolve_body(body, body_file)
    if not text.strip():
        click.echo("No body provided. Use --body, --body-file, or pipe text on stdin.", err=True)
        sys.exit(1)
    return text.strip()


def _fmt_labels(labels):
    return ", ".join(lbl.get("name", "") for lbl in (labels or []) if lbl)


def _fmt_repo_line(r):
    stars = r.get("stargazers_count", 0)
    lang = r.get("language") or "?"
    desc = (r.get("description") or "").strip()
    line = f"{r['full_name']} ★{stars} | {lang}"
    if desc:
        line += f" | {desc[:120]}"
    return line


