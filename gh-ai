            click.echo("--value required with --set", err=True)
            sys.exit(1)
        key = _request(f"/repos/{repo}/agents/secrets/public-key")
        encrypted = _encrypt_secret(key.get("key", ""), value)
        _request(f"/repos/{repo}/agents/secrets/{secret_name}", method="PUT",
                 json={"encrypted_value": encrypted, "key_id": key.get("key_id", "")})
        click.echo(f"✓ Agent secret {secret_name} set")
        return
    data = _request(f"/repos/{repo}/agents/secrets")
    names = [s.get("name") for s in data.get("secrets", [])]
    click.echo(", ".join(names) if names else "(no agent secrets)")


@cli.command(name="agent-variable")
@click.argument("repo")
@click.option("--set", "var_name", default=None, help="Variable name to set")
@click.option("--value", default=None, help="Variable value (for --set)")
@click.option("--delete", "delete_name", default=None, help="Variable name to delete")
def agent_variable(repo, var_name, value, delete_name):
    """Manage GitHub Agents variables: list (default), --set, --delete."""
    if delete_name:
        _request(f"/repos/{repo}/agents/variables/{delete_name}", method="DELETE")
        click.echo(f"✓ Agent variable {delete_name} deleted")
        return
    if var_name:
        if value is None:
            click.echo("--value required with --set", err=True)
            sys.exit(1)
        resp = requests.get(f"{BASE_URL}/repos/{repo}/agents/variables/{var_name}",
                            headers=_headers(), timeout=30)
        if resp.status_code == 404:
            _request(f"/repos/{repo}/agents/variables", method="POST",
                     json={"name": var_name, "value": value})
            click.echo(f"✓ Agent variable {var_name} set (created)")
        elif resp.status_code >= 400:
            _fail_status(resp, f"/repos/{repo}/agents/variables/{var_name}")
        else:
            _request(f"/repos/{repo}/agents/variables/{var_name}", method="PATCH",
                     json={"value": value})
            click.echo(f"✓ Agent variable {var_name} set (updated)")
        return
    data = _request(f"/repos/{repo}/agents/variables")
    vars_ = data.get("variables", [])
    if not vars_:
        click.echo("(no agent variables)")
        return
    for v in vars_:
        click.echo(f"{v.get('name', '?')} = {v.get('value', '')}")


